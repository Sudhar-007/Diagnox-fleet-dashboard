PORT=4000
# mock | fastapi | hybrid
DATA_SOURCE=mock
# Public HTTPS URL of the FastAPI backend (used by fastapi and hybrid modes)
FASTAPI_URL=
# Comma separated. "*" matches any subdomain label, e.g. https://fleet-*.vercel.app
CORS_ORIGINS=http://localhost:5173
# Timezone used to interpret contract timestamps (they carry no TZ suffix)
TZ=Asia/Kolkata
# Demo scenario panel (POST /api/demo/scenario). false disables it.
DEMO_ENABLED=true
