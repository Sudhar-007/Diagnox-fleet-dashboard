PORT=4000
# mock (simulator only) | hybrid (simulator + device) | device (device only)
DATA_SOURCE=mock
# Key the truck device sends in the x-api-key header to POST /api/telemetry (hybrid, device).
# Generate a long random value; never commit the real one.
TELEMETRY_API_KEY=
# Comma separated. "*" matches any subdomain label, e.g. https://fleet-*.vercel.app
CORS_ORIGINS=http://localhost:5173
# Timezone used to interpret contract timestamps (they carry no TZ suffix)
TZ=Asia/Kolkata
# Demo scenario panel (POST /api/demo/scenario). false disables it.
DEMO_ENABLED=true
# Folder for manager-entered data (JSON backend)
DATA_DIR=data
# true only when DATA_DIR survives restarts (e.g. a mounted disk)
DATA_PERSISTENT=false
